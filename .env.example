# TMDB (https://www.themoviedb.org/settings/api) - fill one of the two, then restart the app.
# Without them, the library works normally but films aren't enriched (poster, synopsis, year)
# and the Discover section stays empty.
TMDB_API_KEY=
# TMDB_ACCESS_TOKEN=

# language of titles/synopses returned by TMDB (default fr-FR)
# TMDB_LANGUAGE=fr-FR
